---
import Layout from "../../components/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFilters from "../../components/ProjectFilters.astro";
import { loadAndValidateCatalogue } from "../../lib/catalogue";
const catalogue = loadAndValidateCatalogue();
---
<Layout title="Projects | RetroPortDB" description="Browse curated modern ports, decompilations, recompilations, and reimplementations.">
  <header class="page-heading"><p class="eyebrow">Catalogue</p><h1>Projects</h1><p>Every record represents an upstream project, not a download. Filtered results are still ordinary static links.</p></header>
  <ProjectFilters catalogue={catalogue} />
  <div class="cards">{catalogue.projects.map((project) => <ProjectCard catalogue={catalogue} project={project} />)}</div>
</Layout>
